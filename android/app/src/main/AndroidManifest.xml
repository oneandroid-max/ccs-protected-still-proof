<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 14+ reports screenshot attempts on an activity to this app; the refusal itself needs no permission. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <!-- The test platform (LabActivity) loads the proof pages from the site inside the app's own web view. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <activity
            android:name=".ViewerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The same link the web proof uses opens this viewer; the #k= fragment carries the key. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="oneandroid-max.github.io" android:pathPrefix="/ccs-protected-still-proof/" />
            </intent-filter>
            <!-- ccsproof://open?k=... opens the viewer without the browser's "open with" choice. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ccsproof" />
            </intent-filter>
        </activity>

        <!-- The Android test platform: every variable switched live (the secure window flag, native photo
             or any proof page in a web view) with a measured readout. Opened from the viewer only. -->
        <activity
            android:name=".LabActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />
    </application>
</manifest>
